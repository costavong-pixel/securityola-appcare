#!/usr/bin/python3
"""Validate the installed release before importing any AppCare package code."""

from __future__ import annotations

import hashlib
import importlib
import importlib.metadata
import json
import os
import re
import stat
import sys
from collections.abc import Mapping, Sequence
from pathlib import Path

_PACKAGE_NAME = "securityola-appcare"
_SCHEMA_VERSION = 1
_APPROVAL_SCHEMA_VERSION = 1
_MAX_MANIFEST_BYTES = 16_384
_MAX_BOUND_FILE_BYTES = 4 * 1024 * 1024
_MAX_PACKAGE_FILES = 4096
_MAX_PACKAGE_TREE_BYTES = 64 * 1024 * 1024
_EXPECTED_MODULE_RELATIVE_PATH = "connectors/ssh_command_wrapper.py"
_EXPECTED_BINDING_RELATIVE_PATH = "connectors/release_binding.py"
_APPCARE_SSH_WRAPPER_PATH = Path("/usr/local/libexec/securityola-appcare-ssh-wrapper")
_APPCARE_RELEASE_GUARD_PATH = Path("/usr/local/libexec/securityola-appcare-release-guard")
_APPCARE_RELEASE_MANIFEST_PATH = Path("/etc/securityola/appcare/ssh-release.json")
_APPCARE_APPROVED_RELEASE_PATH = Path("/etc/securityola/appcare/approved-release.json")
_RELEASE_REVISION = re.compile(r"^[0-9a-f]{40,64}$")
_PACKAGE_VERSION = re.compile(r"^[A-Za-z0-9][A-Za-z0-9.!+_-]{0,63}$")
_SHA256 = re.compile(r"^[0-9a-f]{64}$")


class ReleaseGuardError(ValueError):
    """The root-owned release approval and installed artifact do not match."""


def main(argv: Sequence[str] | None = None) -> int:
    arguments = tuple(sys.argv[1:] if argv is None else argv)
    try:
        if os.name != "posix":
            raise ReleaseGuardError("release guard requires POSIX")
        if arguments[:1] == ("--install-release",):
            return _install(arguments[1:])
        if "--install-release" in arguments:
            raise ReleaseGuardError("release guard mode is invalid")
        candidate = _candidate()
        approved = _approved_release()
        manifest_path = _validated_path(_APPCARE_RELEASE_MANIFEST_PATH, "release manifest")
        manifest = _manifest(_read_trusted_file(manifest_path, "release manifest"))
        _verify_runtime(candidate, approved, manifest)
        return _run_source(Path(candidate["module_path"]), Path(candidate["package_root"]))
    except (ImportError, KeyError, OSError, ReleaseGuardError, TypeError, ValueError):
        return _reject()


def _install(arguments: tuple[str, ...]) -> int:
    if os.name != "posix" or os.geteuid() != 0:
        raise ReleaseGuardError("release installation requires root")
    if len(arguments) != 2 or arguments[0] != "--release-revision":
        raise ReleaseGuardError("release installer arguments are invalid")
    revision = _validate_revision(arguments[1], field_name="release revision")
    approved = _approved_release()
    if revision != approved["release_revision"]:
        raise ReleaseGuardError("release revision is not approved")
    candidate = _candidate()
    if (
        candidate["package_version"] != approved["package_version"]
        or candidate["artifact_sha256"] != approved["artifact_sha256"]
    ):
        raise ReleaseGuardError("installed artifact is not approved")
    sys.argv = [str(_APPCARE_RELEASE_GUARD_PATH), "--release-revision", revision]
    return _run_source(Path(candidate["binding_path"]), Path(candidate["package_root"]))


def _verify_runtime(
    candidate: dict[str, object],
    approved: dict[str, str],
    manifest: dict[str, str | int],
) -> None:
    if manifest["release_revision"] != approved["release_revision"]:
        raise ReleaseGuardError("release revision is not approved")
    if (
        manifest["package_version"] != approved["package_version"]
        or manifest["artifact_sha256"] != approved["artifact_sha256"]
    ):
        raise ReleaseGuardError("release approval does not match the manifest")
    for field in (
        "package_version",
        "wrapper_path",
        "wrapper_sha256",
        "guard_path",
        "guard_sha256",
        "module_path",
        "module_sha256",
        "binding_path",
        "binding_sha256",
        "package_tree_sha256",
        "artifact_sha256",
    ):
        if manifest[field] != candidate[field]:
            raise ReleaseGuardError(f"release {field} does not match")


def _candidate() -> dict[str, object]:
    try:
        distribution = importlib.metadata.distribution(_PACKAGE_NAME)
    except importlib.metadata.PackageNotFoundError as exc:
        raise ReleaseGuardError("release package metadata is unavailable") from exc
    package_version = distribution.version
    if not isinstance(package_version, str) or _PACKAGE_VERSION.fullmatch(package_version) is None:
        raise ReleaseGuardError("release package version is invalid")
    module = _resolved_path(
        Path(distribution.locate_file("appcare/connectors/ssh_command_wrapper.py")),
        "AppCare SSH module",
    )
    package_root = _package_root(module)
    if _package_relative_path(module, package_root) != _EXPECTED_MODULE_RELATIVE_PATH:
        raise ReleaseGuardError("release module path is not the approved entrypoint")
    binding = _resolved_path(
        package_root / _EXPECTED_BINDING_RELATIVE_PATH, "release binding module"
    )
    if _package_relative_path(binding, package_root) != _EXPECTED_BINDING_RELATIVE_PATH:
        raise ReleaseGuardError("release binding path is invalid")
    wrapper = _validated_path(_APPCARE_SSH_WRAPPER_PATH, "SSH wrapper")
    guard = _validated_path(_APPCARE_RELEASE_GUARD_PATH, "release guard")
    wrapper_sha256 = _sha256_file(wrapper, "SSH wrapper", executable=True)
    guard_sha256 = _sha256_file(guard, "release guard", executable=True)
    module_sha256 = _sha256_file(module, "AppCare SSH module")
    binding_sha256 = _sha256_file(binding, "release binding module")
    package_tree_sha256 = _package_tree_sha256(package_root)
    return {
        "package_root": package_root,
        "package_version": package_version,
        "wrapper_path": _APPCARE_SSH_WRAPPER_PATH.as_posix(),
        "wrapper_sha256": wrapper_sha256,
        "guard_path": _APPCARE_RELEASE_GUARD_PATH.as_posix(),
        "guard_sha256": guard_sha256,
        "module_path": module.as_posix(),
        "module_sha256": module_sha256,
        "binding_path": binding.as_posix(),
        "binding_sha256": binding_sha256,
        "package_tree_sha256": package_tree_sha256,
        "artifact_sha256": _artifact_sha256(
            package_version=package_version,
            wrapper_sha256=wrapper_sha256,
            guard_sha256=guard_sha256,
            module_sha256=module_sha256,
            binding_sha256=binding_sha256,
            package_tree_sha256=package_tree_sha256,
        ),
    }


def _manifest(raw: bytes) -> dict[str, str | int]:
    try:
        value = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ReleaseGuardError("release manifest is invalid") from exc
    expected = {
        "schema_version",
        "release_revision",
        "package_version",
        "wrapper_path",
        "wrapper_sha256",
        "guard_path",
        "guard_sha256",
        "module_path",
        "module_sha256",
        "binding_path",
        "binding_sha256",
        "package_tree_sha256",
        "artifact_sha256",
    }
    if not isinstance(value, Mapping) or set(value) != expected:
        raise ReleaseGuardError("release manifest schema is invalid")
    schema_version = value.get("schema_version")
    revision = value.get("release_revision")
    version = value.get("package_version")
    wrapper_path = value.get("wrapper_path")
    wrapper_sha256 = value.get("wrapper_sha256")
    guard_path = value.get("guard_path")
    guard_sha256 = value.get("guard_sha256")
    module_path = value.get("module_path")
    module_sha256 = value.get("module_sha256")
    binding_path = value.get("binding_path")
    binding_sha256 = value.get("binding_sha256")
    package_tree_sha256 = value.get("package_tree_sha256")
    artifact_sha256 = value.get("artifact_sha256")
    if (
        type(schema_version) is not int
        or schema_version != _SCHEMA_VERSION
        or not isinstance(revision, str)
        or _RELEASE_REVISION.fullmatch(revision) is None
        or not isinstance(version, str)
        or _PACKAGE_VERSION.fullmatch(version) is None
        or wrapper_path != _APPCARE_SSH_WRAPPER_PATH.as_posix()
        or not isinstance(wrapper_sha256, str)
        or _SHA256.fullmatch(wrapper_sha256) is None
        or guard_path != _APPCARE_RELEASE_GUARD_PATH.as_posix()
        or not isinstance(guard_sha256, str)
        or _SHA256.fullmatch(guard_sha256) is None
        or not _safe_absolute_path(module_path)
        or not isinstance(module_sha256, str)
        or _SHA256.fullmatch(module_sha256) is None
        or not _safe_absolute_path(binding_path)
        or not isinstance(binding_sha256, str)
        or _SHA256.fullmatch(binding_sha256) is None
        or not isinstance(package_tree_sha256, str)
        or _SHA256.fullmatch(package_tree_sha256) is None
        or not isinstance(artifact_sha256, str)
        or _SHA256.fullmatch(artifact_sha256) is None
    ):
        raise ReleaseGuardError("release manifest values are invalid")
    return {
        "schema_version": schema_version,
        "release_revision": revision,
        "package_version": version,
        "wrapper_path": wrapper_path,
        "wrapper_sha256": wrapper_sha256,
        "guard_path": guard_path,
        "guard_sha256": guard_sha256,
        "module_path": module_path,
        "module_sha256": module_sha256,
        "binding_path": binding_path,
        "binding_sha256": binding_sha256,
        "package_tree_sha256": package_tree_sha256,
        "artifact_sha256": artifact_sha256,
    }


def _approved_release() -> dict[str, str]:
    raw = _read_trusted_file(
        _validated_path(_APPCARE_APPROVED_RELEASE_PATH, "approved release"),
        "approved release",
    )
    if len(raw) > _MAX_MANIFEST_BYTES:
        raise ReleaseGuardError("approved release is too large")
    try:
        value = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ReleaseGuardError("approved release is invalid") from exc
    expected = {"schema_version", "release_revision", "package_version", "artifact_sha256"}
    if not isinstance(value, Mapping) or set(value) != expected:
        raise ReleaseGuardError("approved release schema is invalid")
    schema_version = value.get("schema_version")
    release_revision = value.get("release_revision")
    package_version = value.get("package_version")
    artifact_sha256 = value.get("artifact_sha256")
    if (
        type(schema_version) is not int
        or schema_version != _APPROVAL_SCHEMA_VERSION
        or not isinstance(release_revision, str)
        or _RELEASE_REVISION.fullmatch(release_revision) is None
        or not isinstance(package_version, str)
        or _PACKAGE_VERSION.fullmatch(package_version) is None
        or not isinstance(artifact_sha256, str)
        or _SHA256.fullmatch(artifact_sha256) is None
    ):
        raise ReleaseGuardError("approved release values are invalid")
    return {
        "release_revision": release_revision,
        "package_version": package_version,
        "artifact_sha256": artifact_sha256,
    }


def _artifact_sha256(
    *,
    package_version: str,
    wrapper_sha256: str,
    guard_sha256: str,
    module_sha256: str,
    binding_sha256: str,
    package_tree_sha256: str,
) -> str:
    payload = json.dumps(
        {
            "package_name": _PACKAGE_NAME,
            "package_version": package_version,
            "wrapper_sha256": wrapper_sha256,
            "guard_sha256": guard_sha256,
            "module_sha256": module_sha256,
            "binding_sha256": binding_sha256,
            "package_tree_sha256": package_tree_sha256,
        },
        sort_keys=True,
        separators=(",", ":"),
    ).encode("ascii")
    return hashlib.sha256(payload).hexdigest()


def _package_root(module: Path) -> Path:
    if module.name != "ssh_command_wrapper.py" or module.parent.name != "connectors":
        raise ReleaseGuardError("release module path is invalid")
    root = module.parent.parent
    if root.name != "appcare":
        raise ReleaseGuardError("release package root is invalid")
    return root


def _package_relative_path(path: Path, package_root: Path) -> str:
    try:
        return path.relative_to(package_root).as_posix()
    except ValueError as exc:
        raise ReleaseGuardError("release file is outside the package") from exc


def _package_tree_sha256(package_root: Path) -> str:
    entries: list[bytes] = []
    total_bytes = 0
    for directory, dirnames, filenames in os.walk(package_root, topdown=True, followlinks=False):
        current = Path(directory)
        for dirname in dirnames:
            if (current / dirname).is_symlink():
                raise ReleaseGuardError("release package tree contains a symlink")
        dirnames[:] = sorted(dirname for dirname in dirnames if dirname != "__pycache__")
        for filename in sorted(filenames):
            if filename.endswith(".pyc"):
                raise ReleaseGuardError("release package tree contains bytecode")
            path = current / filename
            if path.is_symlink():
                raise ReleaseGuardError("release package tree contains a symlink")
            relative = _package_relative_path(path, package_root)
            raw = _read_trusted_file(path, f"package file {relative}")
            total_bytes += len(raw)
            if total_bytes > _MAX_PACKAGE_TREE_BYTES:
                raise ReleaseGuardError("release package tree is too large")
            entries.append(f"{relative}\0{hashlib.sha256(raw).hexdigest()}\n".encode())
            if len(entries) > _MAX_PACKAGE_FILES:
                raise ReleaseGuardError("release package tree has too many files")
    if not entries:
        raise ReleaseGuardError("release package tree is empty")
    return hashlib.sha256(b"".join(entries)).hexdigest()


def _safe_absolute_path(value: object) -> bool:
    if not isinstance(value, str) or not value.startswith("/"):
        return False
    path = Path(value)
    return path.as_posix() == value and not any(part in {".", ".."} for part in path.parts)


def _validate_revision(value: object, *, field_name: str) -> str:
    if not isinstance(value, str) or _RELEASE_REVISION.fullmatch(value) is None:
        raise ReleaseGuardError(f"{field_name} is invalid")
    return value


def _validated_path(path: Path, field_name: str) -> Path:
    if (
        not path.is_absolute()
        or path == Path(path.anchor)
        or any(part in {".", ".."} for part in path.parts)
    ):
        raise ReleaseGuardError(f"{field_name} path is unsafe")
    return path


def _resolved_path(path: Path, field_name: str) -> Path:
    path = _validated_path(path, field_name)
    try:
        resolved = path.resolve(strict=True)
    except OSError as exc:
        raise ReleaseGuardError(f"{field_name} is unavailable") from exc
    if resolved != path:
        raise ReleaseGuardError(f"{field_name} is a symlink")
    return resolved


def _trusted_parent(path: Path, field_name: str) -> None:
    current = Path(path.anchor)
    for part in path.parts[1:-1]:
        current /= part
        try:
            metadata = os.lstat(current)
        except OSError as exc:
            raise ReleaseGuardError(f"{field_name} parent is unavailable") from exc
        if not stat.S_ISDIR(metadata.st_mode):
            raise ReleaseGuardError(f"{field_name} parent is invalid")
        if os.name == "posix" and (metadata.st_uid != 0 or stat.S_IMODE(metadata.st_mode) & 0o022):
            raise ReleaseGuardError(f"{field_name} parent ownership is unsafe")


def _read_trusted_file(path: Path, field_name: str, *, executable: bool = False) -> bytes:
    path = _validated_path(path, field_name)
    _trusted_parent(path, field_name)
    if path.is_symlink():
        raise ReleaseGuardError(f"{field_name} is a symlink")
    descriptor = -1
    try:
        descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_size > _MAX_BOUND_FILE_BYTES:
            raise ReleaseGuardError(f"{field_name} is invalid")
        if os.name == "posix" and (metadata.st_uid != 0 or stat.S_IMODE(metadata.st_mode) & 0o022):
            raise ReleaseGuardError(f"{field_name} ownership is unsafe")
        if executable and not metadata.st_mode & 0o111:
            raise ReleaseGuardError(f"{field_name} is not executable")
        chunks: list[bytes] = []
        total = 0
        while total <= _MAX_BOUND_FILE_BYTES:
            chunk = os.read(descriptor, min(65_536, _MAX_BOUND_FILE_BYTES + 1 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        raw = b"".join(chunks)
        if len(raw) != metadata.st_size or len(raw) > _MAX_BOUND_FILE_BYTES:
            raise ReleaseGuardError(f"{field_name} read is incomplete")
        return raw
    except ReleaseGuardError:
        raise
    except OSError as exc:
        raise ReleaseGuardError(f"{field_name} is unavailable") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _sha256_file(path: Path, field_name: str, *, executable: bool = False) -> str:
    return hashlib.sha256(_read_trusted_file(path, field_name, executable=executable)).hexdigest()


def _run_source(path: Path, package_root: Path) -> int:
    module_name = {
        "ssh_command_wrapper.py": "appcare.connectors.ssh_command_wrapper",
        "release_binding.py": "appcare.connectors.release_binding",
    }.get(path.name)
    if module_name is None:
        raise ReleaseGuardError("release entrypoint is invalid")
    previous_path = list(sys.path)
    sys.path.insert(0, package_root.parent.as_posix())
    try:
        module = importlib.import_module(module_name)
        loaded_path = getattr(module, "__file__", None)
        if not isinstance(loaded_path, str) or _resolved_path(
            Path(loaded_path), "loaded release entrypoint"
        ) != path:
            raise ReleaseGuardError("loaded release entrypoint does not match")
        entrypoint = getattr(module, "main", None)
        if not callable(entrypoint):
            raise ReleaseGuardError("release entrypoint is unavailable")
        result = entrypoint()
    finally:
        sys.path[:] = previous_path
    if isinstance(result, bool) or not isinstance(result, int):
        raise ReleaseGuardError("release entrypoint returned an invalid status")
    return result


def _reject() -> int:
    sys.stderr.write("AppCare release guard rejected\n")
    return 126


if __name__ == "__main__":
    raise SystemExit(main())
