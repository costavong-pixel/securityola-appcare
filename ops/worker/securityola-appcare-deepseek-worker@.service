[Unit]
Description=SecurityOla AppCare direct DeepSeek patch worker (%i)
Requires=securityola-appcare-deepseek-api@%i.service
After=securityola-appcare-deepseek-api@%i.service

[Service]
Type=oneshot
User=appcare-deepseek-worker
Group=appcare-deepseek-worker
WorkingDirectory=/opt/securityola/appcare-deepseek-worker/repository
Environment=PATH=/opt/securityola/appcare-deepseek-worker/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/securityola/appcare-deepseek-worker/venv/bin/python -I -B /opt/securityola/appcare-deepseek-worker/repository/scripts/direct_deepseek_worker.py apply --run-id %i
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SETUID CAP_SETGID
LockPersonality=true
MemoryDenyWriteExecute=true
InaccessiblePaths=/etc/securityola/appcare-deepseek-worker/deepseek-api-key
ReadWritePaths=/var/lib/securityola/appcare-deepseek-worker
TasksMax=64
MemoryMax=1G
CPUQuota=100%
LimitNOFILE=256
LimitNPROC=64
RestrictSUIDSGID=true
UMask=0077
TimeoutStartSec=20min

[Install]
WantedBy=multi-user.target
