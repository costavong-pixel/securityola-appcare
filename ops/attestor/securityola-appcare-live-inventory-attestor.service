[Unit]
Description=SecurityOla AppCare root-controlled live inventory attestor
After=local-fs.target
RequiresMountsFor=/etc/securityola/appcare/live-inventory /var/lib/securityola/appcare/evidence/live-inventory

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/libexec/securityola-appcare-live-inventory-attestor
Restart=on-failure
RestartSec=2
TimeoutStartSec=10
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/etc/securityola/appcare/live-inventory /var/lib/securityola/appcare/evidence/live-inventory/operation-evidence.json
ReadWritePaths=/run/securityola/appcare /var/lib/securityola/appcare/evidence/live-inventory
RuntimeDirectory=securityola/appcare
RuntimeDirectoryMode=0750
LimitNOFILE=64
TasksMax=4
MemoryMax=128M

[Install]
WantedBy=multi-user.target
